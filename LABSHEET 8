# Q29: Functions to insert and fetch data
def insert_student_function(con, student):
    con.execute("""
        INSERT INTO students(id, name, age, marks, course_id)
        VALUES (?, ?, ?, ?, ?)
    """, student)
    con.commit()


def fetch_student_function(con):
    return con.execute("SELECT * FROM students").fetchall()


def modular_approach():
    con = connect_database()
    try:
        choice = input("Insert a test record? (y/n): ").lower()

        if choice == "y":
            student = (
                int(input("ID: ")),
                input("Name: "),
                int(input("Age: ")),
                float(input("Marks: ")),
                int(input("Course ID (0 if none): "))
            )
            insert_student_function(con, student)
