# Q2: Create a new database
def create_database():
    try:
        con = sqlite3.connect("student_db.db")
        con.close()
        print("Database created successfully!")
    except sqlite3.Error as e:
        print("Error:", e)


# Q3: Create students table
def create_table():
    con = connect_database()
    try:
        con.execute("""
            CREATE TABLE IF NOT EXISTS students (
                id INTEGER PRIMARY KEY,
                name TEXT NOT NULL,
                age INTEGER,
                marks REAL,
                course_id INTEGER
            )
        """)
        con.commit()
        print("Students table created successfully!")
    except sqlite3.Error as e:
        print("Error:", e)
    finally:
        con.close()


# Q4: Describe table structure
