# Q26: Export students data to CSV
def export_csv():
    con = connect_database()
    try:
        rows = con.execute("SELECT * FROM students").fetchall()
        columns = [item[0] for item in
                   con.execute("SELECT * FROM students").description]

        with open("students.csv", "w", newline="", encoding="utf-8") as file:
            writer = csv.writer(file)
            writer.writerow(columns)
            writer.writerows(rows)

        print("Data exported to students.csv")
    except (sqlite3.Error, OSError) as e:
        print("Error:", e)
    finally:
        con.close()


# Q27: Import CSV data into students table
def import_csv():
    filename = input("Enter CSV filename (default students.csv): ").strip()
    if not filename:
        filename = "students.csv"

    con = connect_database()
    try:
        with open(filename, "r", newline="", encoding="utf-8-sig") as file:
            reader = csv.DictReader(file)
            rows = []

            for row in reader:
                rows.append((
                    int(row["id"]),
                    row["name"],
                    int(row["age"]),
                    float(row["marks"]),
                    int(row.get("course_id") or 0)
                ))

        con.executemany("""
            INSERT OR REPLACE INTO students
            (id, name, age, marks, course_id)
            VALUES (?, ?, ?, ?, ?)
        """, rows)

        con.commit()
        print("CSV data imported successfully!")
    except (sqlite3.Error, OSError, ValueError, KeyError) as e:
        print("Error:", e)
    finally:
        con.close()


