# 25. Count word frequency in a paragraph
paragraph = input("\n25. Enter a paragraph: ").lower()
word_frequency = {}

for word in paragraph.split():
    word = word.strip(".,!?;:\"'()")
    if word:
        word_frequency[word] = word_frequency.get(word, 0) + 1

print("Word frequency:", word_frequency)


# 26. Check if two dictionaries are equal
