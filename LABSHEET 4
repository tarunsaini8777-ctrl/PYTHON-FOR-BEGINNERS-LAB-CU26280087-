# 30. Separate even and odd numbers
numbers = list(map(int, input("\n30. Enter numbers: ").split()))
even = []
odd = []

for num in numbers:
    if num % 2 == 0:
        even.append(num)
    else:
        odd.append(num)

print("Even numbers:", even)
print("Odd numbers:", odd)

