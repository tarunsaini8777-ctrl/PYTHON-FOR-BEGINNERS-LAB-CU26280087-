# 19. Find the most repeated word
s = input("\n19. Enter a sentence: ")
words = s.lower().split()

if words:
    most_repeated = words[0]
    max_count = 0

    for word in words:
        count = words.count(word)
        if count > max_count:
            max_count = count
            most_repeated = word

    print("Most repeated word:", most_repeated)
    print("Frequency:", max_count)
else:
    print("No words found")


