# 8. Convert string to title case without built-in functions
s = input("\n8. Enter a string: ")
result = ""
new_word = True

for ch in s:
    if ch == " ":
        result += ch
        new_word = True
    elif new_word:
        if 'a' <= ch <= 'z':
            result += chr(ord(ch) - 32)
        else:
            result += ch
        new_word = False
    else:
        if 'A' <= ch <= 'Z':
            result += chr(ord(ch) + 32)
        else:
            result += ch

print("Title case:", result)

