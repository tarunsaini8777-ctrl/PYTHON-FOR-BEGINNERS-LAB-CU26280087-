# 1. Check if a string is a palindrome
s = input("1. Enter a string: ")
if s.lower() == s[::-1].lower():
    print("Palindrome")
else:
    print("Not a palindrome")

# 2. Count vowels and consonants
s = input("\n2. Enter a string: ")
vowels = 0
consonants = 0

for ch in s.lower():
    if ch.isalpha():
        if ch in "aeiou":
            vowels += 1
        else:
            consonants += 1

print("Vowels:", vowels)
print("Consonants:", consonants)

