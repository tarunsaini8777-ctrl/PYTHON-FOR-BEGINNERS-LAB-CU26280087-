# 6. Frequency of each character
s = input("\n6. Enter a string: ")
frequency = {}

for ch in s:
    if ch in frequency:
        frequency[ch] += 1
    else:
        frequency[ch] = 1

for ch, count in frequency.items():
    print(repr(ch), ":", count)

