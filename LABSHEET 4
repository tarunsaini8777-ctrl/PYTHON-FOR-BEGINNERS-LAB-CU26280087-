
# 1. Find sum and average of elements in a list
numbers = list(map(int, input("1. Enter numbers: ").split()))

if numbers:
    print("Sum:", sum(numbers))
    print("Average:", sum(numbers) / len(numbers))
else:
    print("List is empty")


# 2. Rotate a list by n positions
numbers = list(map(int, input("\n2. Enter numbers: ").split()))
n = int(input("Enter rotation positions: "))

if numbers:
    n = n % len(numbers)
    rotated = numbers[-n:] + numbers[:-n] if n else numbers[:]
    print("Rotated list:", rotated)
else:
    print("List is empty")


# 3. Remove all negative numbers from a list
numbers = list(map(int, input("\n3. Enter numbers: ").split()))
result = [x for x in numbers if x >= 0]
print("List without negative numbers:", result)


# 4. Find the product of all elements in a list
numbers = list(map(int, input("\n4. Enter numbers: ").split()))
product = 1

for x in numbers:
    product *= x

print("Product:", product if numbers else 0)


# 5. Create a list of squares from 1 to n
n = int(input("\n5. Enter n: "))
squares = [i * i for i in range(1, n + 1)]
print("Squares:", squares)


# 6. Split a list into two halves
numbers = list(map(int, input("\n6. Enter numbers: ").split()))
mid = (len(numbers) + 1) // 2

print("First half:", numbers[:mid])
print("Second half:", numbers[mid:])


# 7. Check if a list is sorted
numbers = list(map(int, input("\n7. Enter numbers: ").split()))

if numbers == sorted(numbers):
    print("List is sorted")
else:
    print("List is not sorted")


# 8. Find pairs whose sum equals a target
numbers = list(map(int, input("\n8. Enter numbers: ").split()))
target = int(input("Enter target sum: "))

for i in range(len(numbers)):
    for j in range(i + 1, len(numbers)):
        if numbers[i] + numbers[j] == target:
            print("Pair:", numbers[i], numbers[j])


# 9. Flatten a nested list
nested = [[1, 2], [3, 4], [5, 6]]
flat = []

for sublist in nested:
    for item in sublist:
        flat.append(item)

print("\n9. Nested list:", nested)
print("Flattened list:", flat)

# 10. Convert a list into a string without using join()
items = ["Python", "is", "easy"]
result = ""

for item in items:
    result += item + " "

print("10. String:", result.strip())


# 11. Create a dictionary of student names and marks
