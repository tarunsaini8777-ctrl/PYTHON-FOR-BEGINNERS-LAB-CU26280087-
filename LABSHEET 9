# ---------- Q4: UPDATE STUDENT MARKS IN A LIST ----------

def q4_update_marks():
    students = [
        {"roll": 1, "name": "Tarun", "marks": 85},
        {"roll": 2, "name": "Aman", "marks": 90}
    ]

    try:
        roll = int(input("Enter roll number: "))
        marks = float(input("Enter new marks: "))

        for student in students:
            if student["roll"] == roll:
                student["marks"] = marks
                print("Marks updated:", student)
                return

        print("Student not found.")

    except ValueError:
        print("Enter valid values.")


# ---------- Q5: DELETE STUDENT BY ROLL NUMBER ----------

def q5_delete_student():
    students = [
        {"roll": 1, "name": "Tarun", "marks": 85},
        {"roll": 2, "name": "Aman", "marks": 90}
    ]

    try:
        roll = int(input("Enter roll number to delete: "))
        updated = [s for s in students if s["roll"] != roll]

        if len(updated) < len(students):
            print("Student deleted.")
        else:
            print("Student not found.")

        print("Remaining records:", updated)

    except ValueError:
        print("Enter a valid roll number.")


# ---------- Q6: CRUD OPERATIONS ON EMPLOYEE DICTIONARY ----------

def q6_employee_crud():
    employees = {}

    while True:
        print("\n1. Add Employee")
        print("2. View Employees")
        print("3. Update Employee")
        print("4. Delete Employee")
        print("5. Back to Main Menu")

        choice = input("Enter choice: ")

        try:
            if choice == "1":
                emp_id = input("Employee ID: ")

                if emp_id in employees:
                    print("Employee ID already exists.")
                    continue

                name = input("Employee name: ")
                salary = float(input("Salary: "))

                employees[emp_id] = {
                    "name": name,
                    "salary": salary
                }
                print("Employee added.")

            elif choice == "2":
                print(employees if employees else "No employees.")

            elif choice == "3":
                emp_id = input("Enter employee ID: ")

                if emp_id in employees:
                    employees[emp_id]["name"] = input("New name: ")
                    employees[emp_id]["salary"] = float(
                        input("New salary: ")
                    )
                    print("Employee updated.")
                else:
                    print("Employee not found.")

            elif choice == "4":
                emp_id = input("Enter employee ID: ")

                if emp_id in employees:
                    del employees[emp_id]
                    print("Employee deleted.")
                else:
                    print("Employee not found.")

            elif choice == "5":
                break

            else:
                print("Invalid choice.")

        except ValueError:
            print("Enter valid data.")


