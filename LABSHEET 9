# ---------- Q19: STUDENT WITH HIGHEST MARKS ----------

def q19_highest_marks():
    con = sqlite3.connect(DB_NAME)

    try:
        row = con.execute("""
            SELECT * FROM students
            WHERE marks = (SELECT MAX(marks) FROM students)
        """).fetchone()

        print("Highest scoring student:", row if row else "No records.")

    except sqlite3.Error as e:
        print("Error:", e)

    finally:
        con.close()


