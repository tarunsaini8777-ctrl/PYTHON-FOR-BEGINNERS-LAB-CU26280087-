# ---------- Q12: INSERT A NEW DATABASE RECORD ----------

def q12_insert_record():
    con = sqlite3.connect(DB_NAME)

    try:
        sid = int(input("Enter student roll/ID: "))
        name = input("Enter name: ")
        age = int(input("Enter age: "))
        marks = float(input("Enter marks: "))

        con.execute(
            "INSERT INTO students(id, name, age, marks) VALUES (?, ?, ?, ?)",
            (sid, name, age, marks)
        )
        con.commit()
        print("Record inserted successfully.")

    except (sqlite3.Error, ValueError) as e:
        print("Error:", e)

    finally:
        con.close()


# ---------- Q13: READ ALL DATABASE RECORDS ----------

def q13_read_records():
    con = sqlite3.connect(DB_NAME)

    try:
        rows = con.execute("SELECT * FROM students").fetchall()

        for row in rows:
            print(row)

        if not rows:
            print("No records found.")

    except sqlite3.Error as e:
        print("Error:", e)

    finally:
        con.close()


