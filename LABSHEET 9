# ---------- Q10: CRUD OPERATIONS ON A JSON FILE ----------

def load_records():
    if not os.path.exists(RECORD_FILE):
        return []

    try:
        with open(RECORD_FILE, "r", encoding="utf-8") as file:
            return json.load(file)
    except (json.JSONDecodeError, OSError):
        return []


def save_records(records):
    with open(RECORD_FILE, "w", encoding="utf-8") as file:
        json.dump(records, file, indent=4)


def q10_file_crud():
    while True:
        print("\n1. Add Record")
        print("2. View Records")
        print("3. Modify Record")
        print("4. Delete Record")
        print("5. Back")

        choice = input("Enter choice: ")

        try:
            records = load_records()

            if choice == "1":
                rid = input("Record ID: ")

                if any(r["id"] == rid for r in records):
                    print("Record ID already exists.")
                    continue

                name = input("Name: ")
                records.append({"id": rid, "name": name})
                save_records(records)
                print("Record added.")

            elif choice == "2":
                print(records if records else "No records found.")

            elif choice == "3":
                rid = input("Record ID to modify: ")
                found = False

                for record in records:
                    if record["id"] == rid:
                        record["name"] = input("New name: ")
                        found = True
                        break

                if found:
                    save_records(records)
                    print("Record updated.")
                else:
                    print("Record not found.")

            elif choice == "4":
                rid = input("Record ID to delete: ")
                updated = [r for r in records if r["id"] != rid]

                if len(updated) == len(records):
                    print("Record not found.")
                else:
                    save_records(updated)
                    print("Record deleted.")

            elif choice == "5":
                break

            else:
                print("Invalid choice.")

        except (OSError, ValueError) as e:
            print("File error:", e)


