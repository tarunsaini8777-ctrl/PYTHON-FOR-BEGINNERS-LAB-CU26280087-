# Q23: Calculate averages of numeric CSV columns.
def q23():
    try:
        with open(CSV_FILE, "r", newline="", encoding="utf-8") as f: rows = list(csv.DictReader(f))
        if not rows: print("No data."); return
        for col in rows[0]:
            vals = []
            for row in rows:
                try: vals.append(float(row[col]))
                except (ValueError, TypeError): pass
            if vals: print(f"Average {col}: {sum(vals)/len(vals):.2f}")
    except FileNotFoundError: print("CSV file not found.")

