# Q13: Sum and average of numbers stored in a file.
def q13():
    filename = "numbers.txt"
    if not os.path.exists(filename):
        with open(filename, "w", encoding="utf-8") as f: f.write("10\n20\n30\n40\n")
    try:
        with open(filename, "r", encoding="utf-8") as f:
            nums = [float(x.strip()) for x in f if x.strip()]
        if nums: print("Sum:", sum(nums), "\nAverage:", sum(nums) / len(nums))
        else: print("No numbers in file.")
    except ValueError: print("File contains invalid numbers.")

